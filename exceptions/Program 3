//handling checked exception (IOException) with try,catch block

import java.io.FileWriter;
import java.io.IOException;
//import java.io.ArithmeticException;
class Main
{
	public static void main(String[] args)
	{
		try
		{
		FileWriter r=new FileWriter("hello.txt");
		r.write("hello");
		}
		catch(IOException e)
		{
			System.out.println(e);
		}
		int n=args.length;
		try
		{
		int a=45/n;
		}
		catch(ArithmeticException a)
		{
			System.out.println(a);
		}
		System.out.println("execution completed");
		
	}
}



// handling checked exception (IOException) with throws keyword
class Main
{
	public static void main(String[] args) throws IOException
	{
		
		FileWriter r=new FileWriter("hello.txt");
		r.write("hello");
		int n=args.length;
		try
		{
		int a=45/n;
		}
		catch(ArithmeticException a)
		{
			System.out.println(a);
		}
		System.out.println("execution completed");
		
	}
}
