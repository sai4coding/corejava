class Main extends Thread
{

	public void run()
	{
		System.out.println("Thread name: "+Thread.currentThread().getName()+" "+"Thread status: "+Thread.currentThread().isAlive());
		for(int i=0;i<=10;i++)
		{
			try
			{

			
			System.out.println(i);
			Thread.sleep(3000);
			
		        }
			catch(Exception e)
			{
				
			}
	 }       }
	public static void main(String[] args)
	{
		Main m=new Main();
		System.out.println("Thread name: "+m.getName()+" "+"Thread status: "+m.isAlive());
		m.start();
		System.out.println("Hi");
		for(int i=0;i<=50;i++)
		{
			System.out.println("Hi");
		}
		System.out.println("Thread name: "+m.getName()+" "+"Thread status: "+m.isAlive());
		
	}

}
