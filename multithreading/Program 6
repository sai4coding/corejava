class Main extends Thread
{
	private int divide;
	Main(int divide)
	{
		this.divide=divide;
	}
	public void run()
	{
		for(int i=1;i<=20;i++)
		{
			if(i%divide==0)
			{
				System.out.println(Thread.currentThread().getName() +": "+i);
			}
		}
	}
	public static void main(String[] args)
	{
		Main m1=new Main(3);
		Main m2=new Main(4);
		m1.setName("3 multiples");
		m2.setName("4 multiples");
		m1.start();
		m2.start();
	}


}
